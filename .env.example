# Bright Data credentials — get these from https://brightdata.com/cp
# After running: npm install -g @brightdata/cli && bdata login
#
# Your API key (zone password) — found in Bright Data Control Panel > Zone settings
BRIGHTDATA_API_KEY=your_zone_password_here

# Zone name — created automatically by bdata login (usually "cli_unlocker")
# Or create a SERP zone in the Bright Data Control Panel
BRIGHTDATA_ZONE=serp

# Proxy port (default 33335 for SERP, 22225 for Web Unlocker)
BRIGHTDATA_PORT=33335
